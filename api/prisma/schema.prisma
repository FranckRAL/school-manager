generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ScolaryYear {
  id         String   @id @default(cuid())
  start_year DateTime
  end_year   DateTime
  is_active  Boolean  @default(false)
  classes    Classe[]
}

enum LevelCategory {
  PRIMAIRE
  SECONDAIRE
  LYCEE
}

model Level {
  id      String   @id @default(cuid())
  name    String
  category LevelCategory
  classes Classe[]
}

model Classe {
  id            String      @id @default(cuid())
  name          String
  description   String?
  levelId       String
  level         Level       @relation(fields: [levelId], references: [id])
  scolaryYearId String
  scolaryYear   ScolaryYear @relation(fields: [scolaryYearId], references: [id])
  students      Student[]
  teachings     Teach[] 
}

model Student {
  matricule          String   @id @default(cuid())
  first_name         String
  last_name1         String
  gender             String
  date_of_birth      DateTime
  father_name        String?
  mother_name        String?
  tutor_phone_number String?
  address            String?
  classeId           String
  classe             Classe   @relation(fields: [classeId], references: [id])
}

model Subject {
  id        String  @id @default(cuid())
  name      String
  teachings Teach[]
}

model Teach {
  id             String  @id @default(cuid())
  subjectId      String
  subject        Subject @relation(fields: [subjectId], references: [id])
  classeId       String
  classe         Classe  @relation(fields: [classeId], references: [id])
  coefficient    Float   @default(1.0)
  duration_total Int
}
